# Trading Configuration - Optimized for Profitability
MAX_SLIPPAGE=0.005                # 0.5% - Tighter for better execution (reduced from 1%)
MAX_GAS_FEE=0.02                 # 0.02 SOL - Higher priority fees for competitive advantage
MIN_PROFIT_THRESHOLD=0.002       # 0.2% - Minimum profit threshold for sustainable trading
MAX_POSITION_SIZE=5000           # $5000 - Larger positions for better profits

# Flashloan Configuration - Enhanced Capital Efficiency
MAX_FLASHLOAN_AMOUNT=500000      # $500k - Increased for larger opportunities

# Liquidation Configuration - Aggressive Settings for Maximum Profit
MAX_CONCURRENT_LIQUIDATIONS=5    # Increased parallel executions
LIQUIDATION_MIN_PROFIT=0.015     # 1.5% - More aggressive threshold
PRIORITY_FEE_MULTIPLIER=3.0      # 3x multiplier for winning liquidation races

# Development/Testing
NODE_ENV=production
LOG_LEVEL=info