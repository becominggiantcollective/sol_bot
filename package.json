{
  "name": "sol_bot",
  "version": "1.0.0",
  "description": "Solana flashloan arbitrage and MEV bot",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "example": "ts-node example.ts",
    "liquidation-example": "ts-node liquidation-example.ts",
    "monitor": "ts-node monitor.ts",
    "backtest": "ts-node backtest-example.ts",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "pre-deploy-check": "node pre-deployment-check.js",
    "deploy-check": "npm run pre-deploy-check"
  },
  "keywords": [
    "solana",
    "arbitrage",
    "flashloan",
    "mev",
    "defi",
    "trading"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@project-serum/anchor": "^0.26.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "axios": "^1.11.0",
    "bn.js": "^5.2.2",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.1",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "eslint": "^9.35.0",
    "jest": "^30.1.3",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
