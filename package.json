{
  "name": "sol_bot",
  "version": "1.0.0",
  "description": "Solana flashloan arbitrage and MEV bot",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:rust": "cargo build --release --features napi && cp target/release/libsol_bot.so native/sol_bot.node",
    "build:all": "npm run build:rust && npm run build",
    "start": "node dist/index.js",
    "sniper": "node --loader ts-node/esm sniper.ts",
    "scan": "node --loader ts-node/esm scan-pools.ts",
    "dev": "ts-node src/index.ts",
    "example": "ts-node example.ts",
    "liquidation-example": "ts-node liquidation-example.ts",
    "monitor": "node --loader ts-node/esm monitor.ts",
    "backtest": "node --loader ts-node/esm backtest-example.ts",
    "backtest:real": "node real-market-backtest.mjs",
    "capital-analysis": "node capital-scaling-analysis.mjs",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "pre-deploy-check": "node pre-deployment-check.js",
    "deploy-check": "npm run pre-deploy-check",
    "sentiment:service": "uvicorn ml.sentiment_service.app:app --reload --port 8000"
  },
  "keywords": [
    "solana",
    "arbitrage",
    "flashloan",
    "mev",
    "defi",
    "trading"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@jup-ag/api": "^6.0.47",
    "@project-serum/anchor": "^0.26.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@solendprotocol/solend-sdk": "^0.14.26",
    "axios": "^1.12.0",
    "blessed": "^0.1.81",
    "blessed-contrib": "^4.11.0",
    "bn.js": "^5.2.2",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.4.5",
    "jito-js-rpc": "^0.2.2",
    "jito-ts": "^4.2.1",
    "node-fetch": "^3.3.2",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/bn.js": "^5.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.1",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "eslint": "^9.35.0",
    "jest": "^30.1.3",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
