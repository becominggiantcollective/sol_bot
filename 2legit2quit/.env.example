# Claude Agent SDK Configuration
# Copy this file to .env and fill in your actual API key

# Required: Your Anthropic API key
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# Optional: Alternative authentication methods (uncomment to use)
# Amazon Bedrock
# CLAUDE_CODE_USE_BEDROCK=1

# Google Vertex AI
# CLAUDE_CODE_USE_VERTEX=1

# Microsoft Foundry
# CLAUDE_CODE_USE_FOUNDRY=1

# Optional: Trading bot specific settings
# You can add custom environment variables here for your trading strategies
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# MIN_PROFIT_THRESHOLD=0.001
# MAX_POSITION_SIZE=100
